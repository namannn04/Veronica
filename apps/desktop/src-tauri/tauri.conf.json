{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veronica",
  "version": "0.1.11",
  "identifier": "io.github.namannn04.Veronica",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "cargo build --release -p veronica-cli && bun run build",
    "devUrl": "http://127.0.0.1:5183",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Veronica",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": true,
        "transparent": false,
        "visible": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": ["$HOME/Music/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Native control center for Ubuntu",
    "longDescription": "Veronica combines agent usage tracking, machine monitoring, media control and desktop utilities into one application.",
    "linux": {
      "deb": {
        "depends": [
          "curl",
          "jq",
          "zenity",
          "libglib2.0-bin",
          "gir1.2-gstreamer-1.0",
          "gir1.2-gst-plugins-base-1.0",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "pipewire-bin"
        ],
        "recommends": [
          "bun"
        ],
        "section": "utils",
        "desktopTemplate": "../../../packaging/linux/veronica.desktop",
        "files": {
          "/usr/bin/vr": "../../../target/release/vr",
          "/usr/share/metainfo/io.github.namannn04.Veronica.metainfo.xml": "../../../packaging/linux/io.github.namannn04.Veronica.metainfo.xml",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/metadata.json": "../../../extension/metadata.json",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/extension.js": "../../../extension/extension.js",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/lib.js": "../../../extension/lib.js",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/stylesheet.css": "../../../extension/stylesheet.css",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/clipboard.js": "../../../extension/clipboard.js",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/cameraPreview.js": "../../../extension/cameraPreview.js",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/actionBridge.js": "../../../extension/actionBridge.js",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/attention.js": "../../../extension/attention.js",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/featureSwitch.js": "../../../extension/featureSwitch.js",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/inhibitors.js": "../../../extension/inhibitors.js",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/keyboardCleaner.js": "../../../extension/keyboardCleaner.js",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/panelReplacement.js": "../../../extension/panelReplacement.js",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/sections.js": "../../../extension/sections.js",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/nowPlaying.js": "../../../extension/nowPlaying.js",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/notchClock.js": "../../../extension/notchClock.js",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/notchPanel.js": "../../../extension/notchPanel.js",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/themes.js": "../../../extension/themes.js",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/ring.js": "../../../extension/ring.js",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/usageCard.js": "../../../extension/usageCard.js",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/settings.js": "../../../extension/settings.js",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/procStats.js": "../../../extension/procStats.js",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/systemStats.js": "../../../extension/systemStats.js",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/focusDim.js": "../../../extension/focusDim.js",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/focusDimMath.js": "../../../extension/focusDimMath.js",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/keystrokeHighlight.js": "../../../extension/keystrokeHighlight.js",
          "/usr/share/gnome-shell/extensions/veronica@namannn04.github.io/keystrokeLabels.js": "../../../extension/keystrokeLabels.js"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "publisher": "Veronica contributors",
    "homepage": "https://github.com/namannn04/veronica"
  }
}
