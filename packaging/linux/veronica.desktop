[Desktop Entry]
Type=Application
Name=Veronica
GenericName=Control Center
Comment=Agent usage, machines, media and desktop utilities in one app
Exec=veronica
# Must match the icon basename the bundler installs under hicolor.
Icon=veronica
Terminal=false
Categories=System;Monitor;
Keywords=usage;claude;codex;monitor;clipboard;control;
StartupNotify=true
StartupWMClass=Veronica

Actions=FileShelf;NotchTools;Services;

[Desktop Action FileShelf]
Name=File Shelf
Exec=veronica --file-shelf

[Desktop Action NotchTools]
Name=Image & QR Tools
Exec=veronica --notch-tools

[Desktop Action Services]
Name=Ports & Docker
Exec=veronica --services
