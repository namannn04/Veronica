add_source() {
  local src="$1" daily="$2" session="$3"
  local n manifest sessions
  if ! jq -e '(.daily | type) == "array"' "$daily" >/dev/null 2>&1; then
    _error "$src daily usage is malformed; previous data preserved"
    return 2
  fi
  n=$(jq '.daily | length' "$daily")
  if [ "$n" = "0" ]; then return 1; fi
  if ! manifest=$(jq -c "$NORM"' { source: $src, label: $label, norm: [ .daily[] | normDay | .breakdowns |= dropSynthetic ] }' \
    --arg src "$src" --arg label "$(label_for "$src")" "$daily"); then
    _error "$src usage normalization failed; previous data preserved"
    return 2
  fi
  if ! jq -e '(.sessions | type) == "array"' "$session" >/dev/null 2>&1; then
    _error "$src session usage is malformed; previous data preserved"
    return 2
  fi
  if ! sessions=$(jq -c '{ source: $src, sessions: [ .sessions[] | { id: (.sessionId // ""), source: $src } ] }' \
    --arg src "$src" "$session"); then
    _error "$src session usage is malformed; previous data preserved"
    return 2
  fi
  printf '%s\n' "$manifest" >>"$TMP/manifest.jsonl"
  printf '%s\n' "$sessions" >>"$TMP/sessions.jsonl"
  _phase "$src" "$n days"
  return 0
}

include_source() {
  local status
  if add_source "$@"; then return 0; else status=$?; fi
  if [ "$status" = "1" ]; then return 0; fi
  exit "$status"
}

CCDAILY='
