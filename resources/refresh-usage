PROJECTS_DIR="$HOME/.claude/projects"
if [ -s "$TMP/manifest.jsonl" ]; then
  [ -s "$TMP/cli.daily.json" ] || echo '{"daily":[]}' >"$TMP/cli.daily.json"
  [ -s "$TMP/cowork.daily.json" ] || echo '{"daily":[]}' >"$TMP/cowork.daily.json"
  jq -c -s '
    (.[1].daily + .[0].daily) as $days
    | reduce ($days[]) as $d ({};
        reduce ($d.modelBreakdowns[]) as $m (.;
          ((($m.inputTokens // 0) + ($m.outputTokens // 0) + ($m.cacheCreationTokens // 0) + ($m.cacheReadTokens // 0))) as $t
          | .[$d.date][$m.modelName] = (if $t > 0 then ($m.cost // 0) / $t else 0 end)))
  ' "$TMP/cli.daily.json" "$TMP/cowork.daily.json" >"$TMP/rates.json"

  WALK='
    def usertext:
      (.message.content // "") as $c
      | (if ($c | type) == "string" then $c
         elif ($c | type) == "array" then
           ([ $c[] | select(type == "object" and .type == "text" and (.text | type == "string")) | .text ] | .[0] // "")
         else "" end)
      | gsub("^\\s+"; "") | gsub("\\s+$"; "");
    def wtof:
      (.cwd // "") as $c
      | (["/.claude/worktrees/", "/.cursor/worktrees/"] | map(select(. as $m | $c | contains($m))) | .[0]) as $m
      | if $m == null then null
        else ($c | split($m)[1] // "" | split("/") | map(select(. != "")) | .[0]) end;
    if .type == "ai-title" and ((.aiTitle // "") != "") and ((.sessionId // "") != "") then
      {t: "title", sid: .sessionId, title: (.aiTitle | tostring | gsub("^\\s+"; "") | gsub("\\s+$"; ""))}
    elif .type == "user" and ((.sessionId // "") != "") then
      usertext as $x
      | if $x != "" and ($x | startswith("<") | not)
        then {t: "text", sid: .sessionId, tms: (.timestamp // ""), text: $x[0:80]}
        else empty end
    elif .type == "assistant" and (.message.usage != null) then
      (.message.id // .requestId // "") as $id
      | if $id == "" then empty else
        (.timestamp | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) as $ep
        | ($ep + $off) as $loc
        | (.message.usage) as $u
        | ($u.input_tokens // 0) as $inp | ($u.output_tokens // 0) as $out
        | ([($u.cache_creation_input_tokens // 0),
            (($u.cache_creation.ephemeral_5m_input_tokens // 0)
              + ($u.cache_creation.ephemeral_1h_input_tokens // 0))] | max) as $cc
        | ($u.cache_read_input_tokens // 0) as $cr
        | { t: "rec", id: $id, date: ($loc | strftime("%Y-%m-%d")), hour: (($loc / 3600 | floor) % 24),
            ts: ($ep * 1000), model: (.message.model // "unknown"), cwd: (.cwd // ""), wt: wtof,
            sid: (.sessionId // ""), src: $src,
            inp: $inp, out: $out, cc: $cc, cr: $cr, tok: ($inp + $out + $cc + $cr) }
        end
    else empty end
  '

  WALKC='
    [., inputs] as $L
    | ([ $L[] | select(.type == "session_meta") ] | .[0].payload) as $meta
    | (($meta.id // "") | tostring) as $sid
    | if $sid == "" then empty else
        ({
          t: "meta", sid: $sid, cwd: ($meta.cwd // ""), src: $src,
          sessionFile: ((input_filename // "<stdin>")
            | split("/")[-1] | sub("\\.jsonl$"; ""))
        },
        ($L[]
          | if .type == "event_msg" and (.payload.type == "user_message") then
              ((.payload.message // "") | tostring
                | gsub("^\\s+"; "") | gsub("\\s+$"; "")) as $text
              | if $text != "" and ($text | startswith("<") | not) then
                  {t: "text", sid: $sid, tms: (.timestamp // ""), text: $text[0:80]}
                else empty end
            else empty end))
      end
  '

  CODEX_DETAILS='
    def timestampMillis:
      if type == "number" then if . > 100000000000 then . else . * 1000 end
      elif type == "string" then
        (try capture("\\.(?<fraction>[0-9]+)Z$").fraction catch "0") as $fraction
        | (sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601 * 1000)
          + (($fraction + "000")[0:3] | tonumber)
      else 0 end;
    ($metadata | map({(.sessionFile): .}) | add // {}) as $meta
    | $sessions[]
    | . as $session
    | ($meta[($session.sessionFile // "")]
      // $meta[($session.sessionId // "" | split("/")[-1])] // {}) as $sessionMeta
    | ([($session.models // {}) | to_entries[]
        | .value as $usage
        | {
            model: .key,
            inp: ($usage.inputTokens // 0),
            out: ($usage.outputTokens // 0),
            cc: ($usage.cacheCreationTokens // 0),
            cr: ($usage.cacheReadTokens // 0)
          }
        | . + {tok: (.inp + .out + .cc + .cr)}]
      | if length > 0 then . else [{
          model: "unknown",
          inp: ($session.inputTokens // 0),
          out: ($session.outputTokens // 0),
          cc: ($session.cacheCreationTokens // 0),
          cr: ($session.cacheReadTokens // 0),
          tok: ($session.totalTokens // 0)
        }] end) as $models
    | ([ $models[].tok ] | add // 0) as $sessionTokens
    | (($session.lastActivity // ($session.date + "T00:00:00Z")) | timestampMillis) as $ts
    | $models[]
    | select(.tok > 0)
    | . as $model
    | {
        t: "rec",
        id: (["codex", $session.date, ($session.sessionFile // $session.sessionId), $model.model]
          | join(":")),
        date: $session.date,
        hour: (((($ts / 1000 | floor) + $off) / 3600 | floor) % 24),
        ts: $ts,
        model: $model.model,
        cwd: ($sessionMeta.cwd // ""),
        wt: null,
        sid: ($sessionMeta.sid // $session.sessionId // ""),
        src: "codex",
        cost: (if $sessionTokens > 0 then
          ($session.costUSD // 0) * $model.tok / $sessionTokens else 0 end),
        inp: $model.inp,
        out: $model.out,
        cc: $model.cc,
        cr: $model.cr,
        tok: $model.tok
      }
  '

  WALKPI='
    def trimmedText:
      if type == "string" then .
      elif type == "array" then
        ([ .[] | select(type == "object" and .type == "text" and (.text | type == "string")) | .text ] | .[0] // "")
      else "" end
      | gsub("^\\s+"; "") | gsub("\\s+$"; "");
    [., inputs] as $L
    | ([ $L[] | select(.type == "session") ] | .[0]) as $meta
    | (($meta.id // "") | tostring) as $sid
    | if $sid == "" then empty else
        ($meta.cwd // "") as $cwd
        | ($L[]
          | if .type == "session_info" and ((.name // "") != "") then
              {t: "title", sid: $sid, title: (.name | tostring | gsub("^\\s+"; "") | gsub("\\s+$"; ""))}
            elif .type == "message" and .message.role == "user" then
              (.message.content | trimmedText) as $x
              | if $x != "" and ($x | startswith("<") | not) then
                  {t: "text", sid: $sid, tms: (.timestamp // ""), text: $x[0:80]}
                else empty end
            elif ((.type == "message" and (.message.role == "assistant" or .message.role == "toolResult")
                    and (.message.usage | type) == "object")
                  or ((.type == "compaction" or .type == "branch_summary") and (.usage | type) == "object")) then
              (if .type == "message" then .message.usage else .usage end) as $u
              | ($u.input // 0) as $inp | ($u.output // 0) as $out
              | ($u.cacheWrite // 0) as $cc | ($u.cacheRead // 0) as $cr
              | if ($inp + $out + $cc + $cr) == 0 then empty else
                  (.timestamp | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) as $ep
                  | ($ep + $off) as $loc
                  | { t: "rec", id: ($src + ":" + $sid + ":" + (.id // ($ep | tostring))),
                      date: ($loc | strftime("%Y-%m-%d")), hour: (($loc / 3600 | floor) % 24),
                      ts: ($ep * 1000), model: (.message.model // .model // "unknown"), cwd: $cwd, wt: null,
                      sid: $sid, src: $src, cost: ($u.cost.total // 0),
                      inp: $inp, out: $out, cc: $cc, cr: $cr,
                      tok: ($inp + $out + $cc + $cr) }
                end
            else empty end)
      end
  '

  WALKCC='
    [., inputs] as $L
    | ([ $L[] | select(.type == "session") ] | .[0]) as $meta
    | (($meta.id // "") | tostring) as $sid
    | if $sid == "" then empty else
        ($meta.cwd // "") as $cwd
        | ( $L | to_entries[] | .key as $i | .value
            | if .type != "message" then empty
              elif .message.role == "user" then
                . as $m
                | ( [ ($m.message.content // [])[]
                      | select(type == "object" and .type == "text" and (.text | type == "string"))
                      | .text ] | .[0] // ""
                    | gsub("^\\s+"; "") | gsub("\\s+$"; "") ) as $x
                | if $x != "" and ($x | startswith("<") | not)
                  then {t: "text", sid: $sid, tms: ($m.timestamp // ""), text: $x[0:80]}
                  else empty end
              elif (.usage != null) and (.timestamp != null) then
                (.usage) as $u
                | ($u.inputTokens // 0) as $inp | ($u.outputTokens // 0) as $out
                | ($u.cacheWriteTokens // 0) as $cc | ($u.cacheReadTokens // 0) as $cr
                | if ($inp + $out + $cc + $cr) == 0 then empty else
                    (.timestamp | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) as $ep
                    | ($ep + $off) as $loc
                    | { t: "rec", id: ($sid + ":" + ($i | tostring)),
                        date: ($loc | strftime("%Y-%m-%d")), hour: (($loc / 3600 | floor) % 24),
                        ts: ($ep * 1000), model: (.model // "unknown"), cwd: $cwd, wt: null,
                        sid: $sid, src: $src, cost: ($u.costUsd // 0),
                        inp: $inp, out: $out, cc: $cc, cr: $cr,
                        tok: ($inp + $out + $cc + $cr) }
                  end
              else empty end )
      end
  '

  DEDUP='
    group_by(.id)
    | map(max_by([.tok, .ts]))
  '

  RECONCILE='
    ($usage[0].daily
      | map(. as $day
          | (.bySource | to_entries[])
          | ([.value[] | ((.inputTokens // 0) + (.outputTokens // 0)
              + (.cacheCreationTokens // 0) + (.cacheReadTokens // 0))] | add // 0) as $tokens
          | {key: ($day.period + "|" + .key), value: {
              tokens: $tokens,
              cost: ([.value[].cost // 0] | add // 0)
            }})
      | from_entries) as $authoritative
    | group_by(.date + "|" + .src)
    | map(. as $records
        | ($authoritative[($records[0].date + "|" + $records[0].src)]
          // {tokens: 0, cost: 0}) as $limit
        | (reduce ($records | sort_by(.ts, .id)[]) as $record
            ({remaining: $limit.tokens, records: []};
              ([$record.tok, .remaining] | min) as $tokens
              | if $tokens <= 0 then . else
                  ($tokens / $record.tok) as $ratio
                  | .records += [$record
                    | .inp *= $ratio
                    | .out *= $ratio
                    | .cc *= $ratio
                    | .cr *= $ratio
                    | .tok = $tokens
                    | .cost *= $ratio]
                  | .remaining -= $tokens
                end)
          | .records) as $capped
        | ([ $capped[].cost ] | add // 0) as $cost
        | (if $cost > $limit.cost and $cost > 0 then $limit.cost / $cost else 1 end) as $costRatio
        | $capped | map(.cost *= $costRatio))
    | add // []
  '

  DETAILS='
    def sourceBreakdown:
      group_by(.src)
      | map(. as $sourceRecords
          | ($sourceRecords | group_by(.model)
              | map(. as $modelRecords | {
                  key: ($modelRecords[0].model // "unknown"),
                  value: {
                    tokens: ([ $modelRecords[].tok ] | add // 0),
                    cost: ([ $modelRecords[].cost ] | add // 0)
                  }
                })
              | from_entries) as $byModel
          | {
              key: ($sourceRecords[0].src // ""),
              value: {
                tokens: ([ $sourceRecords[].tok ] | add // 0),
                cost: ([ $sourceRecords[].cost ] | add // 0),
                byModel: $byModel
              }
            })
      | from_entries;
    def pathBreakdown:
      group_by(.cwd)
      | map(. as $pathRecords | {
          key: ($pathRecords[0].cwd // ""),
          value: {
            tokens: ([ $pathRecords[].tok ] | add // 0),
            cost: ([ $pathRecords[].cost ] | add // 0),
            bySource: ($pathRecords | sourceBreakdown)
          }
        })
      | from_entries;
    def sourceHours:
      group_by(.hour)
      | map(. as $hourRecords | {
          hour: $hourRecords[0].hour,
          tokens: ([ $hourRecords[].tok ] | add // 0),
          cost: ([ $hourRecords[].cost ] | add // 0),
          bySource: ($hourRecords | sourceBreakdown),
          byPath: ($hourRecords | pathBreakdown)
        });
    . as $R
    | $usage[0] as $usage
    | ($cm[0] // {}) as $C
    | ($titles[0] // {}) as $T
    | def chatsort: sort_by([-.tokens, .id]);
      ($R | group_by(.date) | map({
          key: .[0].date,
          hours: sourceHours,
          projects: (
            map(. + {m: ($C[.cwd] // {
                root: (.cwd // ""),
                repositoryID: ("folder:" + (.cwd // "")),
                repositoryName: "unknown",
                repositoryURL: null,
                folderName: "unknown"
              })})
            | group_by(.m.repositoryID + "|" + .m.root)
            | map(. as $projectRecords
                | ($projectRecords | group_by(.sid + "|" + (.wt // "")) | map(
                    {
                      wt: (.[0].wt // ""),
                      chat: {
                        id: .[0].sid,
                        path: (max_by(.tok) | .cwd),
                        title: ($T[.[0].sid]
                          // (if .[0].sid != "" then "Chat " + (.[0].sid[0:8]) else "Untitled chat" end)),
                        tokens: (map(.tok) | add),
                        cost: (map(.cost) | add),
                        firstTs: (map(.ts) | min),
                        lastTs: (map(.ts) | max),
                        source: .[0].src
                      }
                    }
                  )) as $chats
                | {
                    projectName: $projectRecords[0].m.repositoryName,
                    repositoryID: $projectRecords[0].m.repositoryID,
                    repositoryName: $projectRecords[0].m.repositoryName,
                    repositoryURL: $projectRecords[0].m.repositoryURL,
                    folderName: $projectRecords[0].m.folderName,
                    path: $projectRecords[0].m.root,
                    tokens: ([ $projectRecords[].tok ] | add // 0),
                    cost: ([ $projectRecords[].cost ] | add // 0),
                    bySource: ($projectRecords | sourceBreakdown),
                    chats: ([ $chats[] | select(.wt == "") | .chat ] | chatsort),
                    worktrees: ([ $chats[] | select(.wt != "") ]
                      | group_by(.wt)
                      | map({
                          name: .[0].wt,
                          tokens: (map(.chat.tokens) | add),
                          cost: (map(.chat.cost) | add),
                          chats: (map(.chat) | chatsort)
                        })
                      | sort_by([-.tokens, .name]))
                  })
            | sort_by([-.tokens, .repositoryName, .folderName])
          )
        })
      | map({(.key): {hours: .hours, projects: .projects}})
      | add // {}) as $BY
    | $usage
    | .schemaVersion = 8
    | .daily = [ .daily[]
        | ($BY[.period]) as $b
        | .hours = ([range(0; 24)] | map(. as $h
            | ($b.hours // [] | map(select(.hour == $h)) | .[0]) as $x
            | {
                tokens: ($x.tokens // 0),
                cost: ($x.cost // 0),
                bySource: ($x.bySource // {}),
                byPath: ($x.byPath // {})
              }))
        | .projects = ($b.projects // [])
      ]
  '

  : >"$TMP/walk.jsonl"
  WCACHE="$EDCACHE/.walkcache"
  mkdir -p "$WCACHE"
  find "$WCACHE" -type f -mtime +45 -delete 2>/dev/null || true
  walk_dir() {
    [ -d "$1" ] || return 0
    local prog="${3:-$WALK}"
    if ! command -v perl >/dev/null 2>&1; then
      find "$1" -name '*.jsonl' -print0 2>/dev/null \
        | while IFS= read -r -d '' file; do
          jq -c --argjson off "$OFF" --arg src "$2" "$prog" "$file" \
            >>"$TMP/walk.jsonl" 2>/dev/null || true
        done
      return 0
    fi
    WALK_DIR="$1" WALK_SRC="$2" WALK_OFF="$OFF" WALK_VER="$(_hash "$prog")" \
      WALK_CACHE="$WCACHE" WALK_OUT="$TMP/walk.jsonl" WALK_PROG="$prog" \
      perl -e '
      use File::Find;
      use Digest::MD5 qw(md5_hex);
      open(STDERR, ">", "/dev/null");
      my ($dir, $src, $off, $ver, $cache, $out, $prog) =
        @ENV{qw(WALK_DIR WALK_SRC WALK_OFF WALK_VER WALK_CACHE WALK_OUT WALK_PROG)};
      open(my $ofh, ">>", $out) or exit 0;
      my @files;
      find(sub { push @files, $File::Find::name if /\.jsonl$/ }, $dir);
      for my $f (@files) {
        my ($size, $mtime) = (stat($f))[7, 9];
        next unless defined $size;
        my $cf = "$cache/" . md5_hex("$f|$src");
        my $meta = "#$mtime $size $off $ver";
        if (open(my $ch, "<", $cf)) {
          my $first = <$ch> // "";
          chomp $first;
          if ($first eq $meta) {
            print {$ofh} $_ while <$ch>;
            close $ch;
            utime undef, undef, $cf;
            next;
          }
          close $ch;
        }
        open(my $cw, ">", "$cf.tmp") or next;
        print {$cw} "$meta\n";
        if (open(my $jq, "-|", "jq", "-c", "--argjson", "off", $off,
            "--arg", "src", $src, $prog, $f)) {
          while (<$jq>) { print {$cw} $_; print {$ofh} $_; }
          close $jq;
        }
        close $cw;
        rename "$cf.tmp", $cf;
      }
    ' 2>/dev/null || true
  }
  OPENCODE_MESSAGES="
    select json_object(
      'sid', m.session_id,
      'ts', json_extract(m.data, '\$.time.created'),
      'cwd', coalesce(nullif(json_extract(m.data, '\$.path.cwd'), ''), s.directory, ''),
      'model', coalesce(json_extract(m.data, '\$.modelID'), 'unknown'),
      'cost', coalesce(json_extract(m.data, '\$.cost'), 0),
      'inp', coalesce(json_extract(m.data, '\$.tokens.input'), 0),
      'out', coalesce(json_extract(m.data, '\$.tokens.output'), 0),
      'cc', coalesce(json_extract(m.data, '\$.tokens.cache.write'), 0),
      'cr', coalesce(json_extract(m.data, '\$.tokens.cache.read'), 0))
    from message m
    left join session s on s.id = m.session_id
    where json_extract(m.data, '\$.role') = 'assistant'
      and json_extract(m.data, '\$.time.created') is not null;
  "
  OPENCODE_MESSAGES_FALLBACK="
    select json_object(
      'sid', m.session_id,
      'ts', json_extract(m.data, '\$.time.created'),
      'cwd', coalesce(json_extract(m.data, '\$.path.cwd'), ''),
      'model', coalesce(json_extract(m.data, '\$.modelID'), 'unknown'),
      'cost', coalesce(json_extract(m.data, '\$.cost'), 0),
      'inp', coalesce(json_extract(m.data, '\$.tokens.input'), 0),
      'out', coalesce(json_extract(m.data, '\$.tokens.output'), 0),
      'cc', coalesce(json_extract(m.data, '\$.tokens.cache.write'), 0),
      'cr', coalesce(json_extract(m.data, '\$.tokens.cache.read'), 0))
    from message m
    where json_extract(m.data, '\$.role') = 'assistant'
      and json_extract(m.data, '\$.time.created') is not null;
  "
  OPENCODE_TITLES="
    select json_object('sid', id, 'title', title)
    from session where coalesce(title, '') != '';
  "
  opencode_sql() {
    local db="$1" sql="$2"
    if command -v bun >/dev/null 2>&1; then
      EDITH_OPENCODE_DB="$db" EDITH_OPENCODE_SQL="$sql" bun -e '
        import { Database } from "bun:sqlite";
        const database = new Database(process.env.EDITH_OPENCODE_DB, { readonly: true });
        for (const row of database.query(process.env.EDITH_OPENCODE_SQL).values()) {
          if (row[0] != null) process.stdout.write(`${row[0]}\n`);
        }
      '
    elif command -v sqlite3 >/dev/null 2>&1; then
      sqlite3 -readonly "$db" "$sql"
    else
      return 1
    fi
  }
  walk_opencode() {
    local db="$HOME/.local/share/opencode/opencode.db"
    [ -f "$db" ] || return 0
    if ! command -v bun >/dev/null 2>&1 && ! command -v sqlite3 >/dev/null 2>&1; then
      install_bun >/dev/null 2>&1 || return 0
    fi
    if ! opencode_sql "$db" "$OPENCODE_MESSAGES" >"$TMP/opencode.rows.jsonl" 2>/dev/null; then
      opencode_sql "$db" "$OPENCODE_MESSAGES_FALLBACK" >"$TMP/opencode.rows.jsonl" 2>/dev/null \
        || return 0
    fi
    jq -c --argjson off "$OFF" --arg src opencode '
        select(.inp + .out + .cc + .cr > 0)
        | (.ts / 1000 | floor) as $ep
        | ($ep + $off) as $loc
        | { t: "rec", id: ($src + ":" + .sid + ":" + (.ts | tostring)),
            date: ($loc | strftime("%Y-%m-%d")), hour: (($loc / 3600 | floor) % 24),
            ts: .ts, model: .model, cwd: .cwd, wt: null,
            sid: .sid, src: $src, cost: .cost,
            inp: .inp, out: .out, cc: .cc, cr: .cr,
            tok: (.inp + .out + .cc + .cr) }' "$TMP/opencode.rows.jsonl" \
      >>"$TMP/walk.jsonl" 2>/dev/null || true
    if opencode_sql "$db" "$OPENCODE_TITLES" >"$TMP/opencode.titles.jsonl" 2>/dev/null; then
      jq -c '{t: "title", sid: .sid, title: .title}' "$TMP/opencode.titles.jsonl" \
        >>"$TMP/walk.jsonl" 2>/dev/null || true
    fi
  }

  NFILES=$(find "$PROJECTS_DIR" -name '*.jsonl' 2>/dev/null | wc -l | tr -d ' ' || true)
  _note "walking $NFILES transcript files"
  walk_dir "$PROJECTS_DIR" cli
  if [ -n "${COWORK_CFG:-}" ]; then
    (
      IFS=','
      for c in $COWORK_CFG; do walk_dir "$c/projects" cowork; done
    )
  fi
  walk_dir "$HOME/.codex/sessions" codex "$WALKC"
  walk_dir "$HOME/.codex/archived_sessions" codex "$WALKC"
  walk_dir "$HOME/.pi/agent/sessions" pi "$WALKPI"
  walk_dir "$CCODE_DIR" commandcode "$WALKCC"
  walk_opencode
  if [ -s "$TMP/cursor.events.jsonl" ]; then
    cat "$TMP/cursor.events.jsonl" >>"$TMP/walk.jsonl"
  fi
  jq -s 'map(select(.t == "meta" and .src == "codex"))' "$TMP/walk.jsonl" \
    >"$TMP/codex.metadata.json"
  jq -c -n --argjson off "$OFF" \
    --slurpfile metadata "$TMP/codex.metadata.json" \
    --slurpfile sessions "$TMP/codex.sessions-by-day.jsonl" \
    '$metadata[0] as $metadata | $sessions as $sessions | '"$CODEX_DETAILS" \
    >>"$TMP/walk.jsonl"
  jq -c 'select(.t == "rec") | del(.t)' "$TMP/walk.jsonl" >"$TMP/records.jsonl"
  jq -s '
    [ .[] | select(.t != "rec") ]
    | (map(select(.t == "text")) | group_by(.sid) | map(sort_by(.tms)[0] | {key: .sid, value: .text}) | from_entries) as $tx
    | (map(select(.t == "title")) | group_by(.sid) | map({key: .[0].sid, value: .[-1].title}) | from_entries) as $ai
    | $tx + $ai
  ' "$TMP/walk.jsonl" >"$TMP/titles.json"
  _phase "walk" "$(wc -l <"$TMP/records.jsonl" | tr -d ' ') messages"

  jq -c '
    reduce ((.daily // [])[]) as $d ({};
      ([ $d.models[]? | ((.inputTokens // 0) + (.outputTokens // 0)
          + (.cacheCreationTokens // 0) + (.cacheReadTokens // 0)) ] | add // 0) as $t
      | .[$d.date] = (if $t > 0 then ($d.costUSD // $d.totalCost // 0) / $t else 0 end))
  ' "$TMP/codex.daily.json" >"$TMP/codex-rates.json" 2>/dev/null || echo '{}' >"$TMP/codex-rates.json"

  jq -s --slurpfile r "$TMP/rates.json" --slurpfile cr "$TMP/codex-rates.json" \
    "$DEDUP"' | map(. + {cost: (
       if .cost != null then .cost
       else .tok *
         (if .src == "codex" then (($cr[0][.date]) // 0)
          else (($r[0][.date][.model]) // 0) end)
       end)})' \
    "$TMP/records.jsonl" >"$TMP/recs.json"
  if ! jq --slurpfile usage "$TMP/usage.json" "$RECONCILE" "$TMP/recs.json" \
    >"$TMP/recs.reconciled.json"; then
    _error "detail assembly failed; previous data preserved"
    exit 1
  fi
  mv "$TMP/recs.reconciled.json" "$TMP/recs.json"

  CWDMAP_CACHE="$EDCACHE/.cwdmap.v5.jsonl"
  LEGACY_CWDMAP_CACHE="$EDCACHE/.cwdmap.v4.jsonl"
  if [ ! -e "$CWDMAP_CACHE" ]; then
    if [ -f "$LEGACY_CWDMAP_CACHE" ]; then
      cp "$LEGACY_CWDMAP_CACHE" "$CWDMAP_CACHE"
    else
      : >"$CWDMAP_CACHE"
    fi
  fi
  jq -r '[.[].cwd] | unique | .[] | select(. != "")' "$TMP/recs.json" | LC_ALL=C sort >"$TMP/cwds.txt"
  : >"$TMP/cwd-fingerprints.jsonl"
  while IFS= read -r cwd; do
    git_probe="$cwd"
    git_root=""
    remote_config=""
    repository_fingerprint=""
    repository_verified=false
    if [ ! -d "$git_probe" ]; then
      for marker in "/.claude/worktrees/" "/.cursor/worktrees/"; do
        case "$cwd" in
          *"$marker"*)
            candidate_root="${cwd%%"$marker"*}"
            if [ -d "$candidate_root" ]; then git_probe="$candidate_root"; fi
            break
            ;;
        esac
      done
    fi
    if [ -d "$git_probe" ]; then
      repository_verified=true
      git_root=$(git_quick -C "$git_probe" rev-parse --path-format=absolute --show-toplevel || true)
      remote_config=$(git_quick -C "$git_probe" config --get-regexp '^remote\..*\.url$' \
        | LC_ALL=C sort || true)
    fi
    if [ -n "$git_root" ]; then
      repository_fingerprint=$(_hash "$git_root|$remote_config")
    elif [ "$repository_verified" = "true" ]; then
      repository_fingerprint=$(_hash "$cwd|not-git")
    fi
    jq -cn --arg cwd "$cwd" --arg fingerprint "$repository_fingerprint" \
      --argjson verified "$repository_verified" \
      '{cwd: $cwd, fingerprint: $fingerprint, verified: $verified}' \
      >>"$TMP/cwd-fingerprints.jsonl"
  done <"$TMP/cwds.txt"
  jq -s 'map({(.cwd): {fingerprint: .fingerprint, verified: .verified}}) | add // {}' \
    "$TMP/cwd-fingerprints.jsonl" >"$TMP/cwd-fingerprints.json"
  jq -c --rawfile want "$TMP/cwds.txt" --slurpfile fingerprints "$TMP/cwd-fingerprints.json" "$CWD_CACHE" \
    "$CWDMAP_CACHE" >"$TMP/cwdmap.jsonl" 2>/dev/null || : >"$TMP/cwdmap.jsonl"
  jq -r '.cwd' "$TMP/cwdmap.jsonl" | LC_ALL=C sort -u >"$TMP/cwds-have.txt"
  comm -23 "$TMP/cwds.txt" "$TMP/cwds-have.txt" | while IFS= read -r cwd; do
    name=""
    root=""
    git_root=""
    repository_id=""
    repository_url=""
    repository_fingerprint=$(jq -r --arg cwd "$cwd" '.[$cwd].fingerprint // ""' "$TMP/cwd-fingerprints.json")
    git_probe="$cwd"
    case "$cwd" in
      */local-agent-mode-sessions/*) name="Cowork" ;;
    esac
    for m in "/.claude/worktrees/" "/.cursor/worktrees/"; do
      case "$cwd" in
        *"$m"*)
          root="${cwd%%"$m"*}"
          break
          ;;
      esac
    done
    if [ ! -d "$git_probe" ] && [ -n "$root" ] && [ -d "$root" ]; then
      git_probe="$root"
    fi
    if [ -d "$git_probe" ]; then
      git_root=$(git_quick -C "$git_probe" rev-parse --path-format=absolute --show-toplevel || true)
    fi
    if [ -z "$root" ] && [ -z "$name" ]; then
      root="$git_root"
    fi
    [ -n "$root" ] || root="$cwd"
    [ -n "$name" ] || name=$(basename "$root")
    if [ -n "$git_root" ]; then
      seen="|"
      remaining_remotes=$(git_quick -C "$git_probe" remote || true)
      for remote in origin upstream $(printf '%s\n' "$remaining_remotes" | LC_ALL=C sort); do
        [ -n "$remote" ] || continue
        [ "$remote" != "." ] || continue
        case "$seen" in
          *"|$remote|"*) continue ;;
        esac
        seen="$seen$remote|"
        remote_url=$(git_quick -C "$git_probe" remote get-url "$remote" || true)
        [ -n "$remote_url" ] || continue
        repository_id=$(jq -nr --arg remote "$remote_url" "$GITHUB"'$remote | githubRepositoryID')
        if [ -n "$repository_id" ]; then
          repository_url="https://$repository_id"
          name="${repository_id##*/}"
          break
        fi
      done
    fi
    folder_name=$(basename "$root")
    [ -n "$repository_id" ] || repository_id="folder:$root"
    jq -cn --arg c "$cwd" --arg n "$name" --arg r "$root" --arg id "$repository_id" \
      --arg url "$repository_url" --arg folder "$folder_name" \
      --arg fingerprint "$repository_fingerprint" \
      '{cwd: $c, name: $n, root: $r, repositoryID: $id, repositoryName: $n,
        repositoryURL: (if $url == "" then null else $url end), folderName: $folder,
        repositoryFingerprint: $fingerprint}' \
      >>"$TMP/cwdmap.jsonl"
  done
  cp "$TMP/cwdmap.jsonl" "$CWDMAP_CACHE"
  _phase "projects" "$(wc -l <"$TMP/cwdmap.jsonl" | tr -d ' ') repos"

  if ! jq \
    --slurpfile usage "$TMP/usage.json" \
    --slurpfile titles "$TMP/titles.json" \
    --slurpfile cm <(jq -s 'map({(.cwd): .}) | add // {}' "$TMP/cwdmap.jsonl") \
    "$DETAILS" "$TMP/recs.json" >"$TMP/merged.json"; then
    _error "detail assembly failed; previous data preserved"
    exit 1
  fi
  mv "$TMP/merged.json" "$TMP/usage.json"
  _phase "merge" "hours + projects merged"
fi

if [ -s "$OUT" ] && jq -e "$HISTORY_INPUT" "$OUT" >/dev/null 2>&1; then
  if ! jq -n --slurpfile previous "$OUT" --slurpfile fresh "$TMP/usage.json" \
    "$HISTORY" >"$TMP/history.json"; then
    _error "usage history merge failed; previous data preserved"
    exit 1
  fi
  mv "$TMP/history.json" "$TMP/usage.json"
  _phase "history" "$(jq '.daily | length' "$TMP/usage.json") days retained"
fi

if [ "$HAS_MACHINES" = "1" ]; then
  if ! jq -s "$FLEET" "$TMP/usage.json" "$MACHINES_DIR"/*.json >"$TMP/fleet.json"; then
    _error "machine snapshot assembly failed; previous data preserved"
    exit 1
  fi
  mv "$TMP/fleet.json" "$TMP/usage.json"
  _phase "machines" "$(jq -r '.machines | length' "$TMP/usage.json") folded in"
fi

if ! jq -e "$VALIDATE" "$TMP/usage.json" >/dev/null; then
  _error "usage validation failed; previous data preserved"
  exit 1
fi
mv "$TMP/usage.json" "$OUT"

DAYS=$(jq '.daily | length' "$OUT")
SESS=$(jq '.sessions | length' "$OUT")
SRCS=$(jq -r '.sources | join(", ")' "$OUT")
MODELS=$(jq '[.daily[].bySource[][].modelName] | unique | length' "$OUT")
FROM=$(jq -r '.daily[0].period // "-"' "$OUT")
TO=$(jq -r '.daily[-1].period // "-"' "$OUT")
COST=$(printf '$%.2f' "$(jq -r '.totals.cost // 0' "$OUT")")
KB=$(awk "BEGIN{printf \"%.0f\", $(wc -c <"$OUT")/1024}")

FLEETNAMES=$(jq -r '[.machines[]?.name] | join(", ")' "$OUT")

_summary "sources" "$SRCS"
if [ -n "$FLEETNAMES" ]; then _summary "machines" "$FLEETNAMES"; fi
_summary "window" "$FROM to $TO · $DAYS days · $MODELS models"
_summary "spend" "$COST · $SESS sessions · $KB KB"
printf 'done\t%s\n' "$(_total)"
