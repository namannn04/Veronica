#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/bin:$HOME/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

case "$(uname -s)" in
  Darwin) DEFAULT_CACHE="$HOME/Library/Application Support/Edith" ;;
  *) DEFAULT_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/edith" ;;
esac
EDCACHE="${EDITH_CACHE_DIR:-$DEFAULT_CACHE}"
mkdir -p "$EDCACHE/bin"
export PATH="$EDCACHE/bin:$EDCACHE/bun/bin:$PATH"

if ! command -v bun >/dev/null 2>&1; then
  NODE_DIR="$HOME/.nvm/versions/node"
  [ -d "$NODE_DIR" ] && export PATH="$NODE_DIR/$(ls "$NODE_DIR" 2>/dev/null | tail -1)/bin:$PATH"
fi

OUT_DIR="${1:-$PWD/data}"
mkdir -p "$OUT_DIR"
OUT="$OUT_DIR/usage.json"
MACHINES_DIR="$OUT_DIR/machines"

TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
trap 'printf "  ✖ collector stopped at line %s\n" "$LINENO" >&2' ERR

_now() { /usr/bin/perl -MTime::HiRes=time -e 'printf "%.3f", time' 2>/dev/null || date +%s; }
_t0=$(_now)
_tlast=$_t0
_phase() {
  local n d
  n=$(_now)
  d=$(awk "BEGIN{printf \"%.2f\", $n-$_tlast}")
  _tlast=$n
  printf 'phase\t%s\t%s\t%s\n' "$1" "$2" "$d"
}
_note() { printf 'note\t%s\n' "$1"; }
_summary() { printf 'summary\t%s\t%s\n' "$1" "$2"; }
_error() { printf 'error\t%s\n' "$1"; }
_total() { awk "BEGIN{printf \"%.2f\", $(_now)-$_t0}"; }

_hash() {
  if command -v md5 >/dev/null 2>&1; then
    md5 -q -s "$1"
  elif command -v md5sum >/dev/null 2>&1; then
    printf '%s' "$1" | md5sum | cut -d' ' -f1
  else
    printf 'v1'
  fi
}

git_quick() {
  local output pid n status
  output="$TMP/git.$$.$RANDOM"
  command git "$@" >"$output" 2>/dev/null &
  pid=$!
  n=0
  while kill -0 "$pid" 2>/dev/null && [ "$n" -lt 100 ]; do
    sleep 0.02
    n=$((n + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -TERM "$pid" 2>/dev/null || true
    rm -f "$output"
    return 124
  fi
  status=0
  wait "$pid" || status=$?
  if [ "$status" = "0" ]; then cat "$output"; fi
  rm -f "$output"
  return "$status"
}

platform_tag() {
  local os arch
  case "$(uname -s)" in
    Darwin) os=macos ;;
    Linux) os=linux ;;
    *) os=unsupported ;;
  esac
  case "$(uname -m)" in
    x86_64 | amd64) arch=amd64 ;;
    aarch64 | arm64) arch=arm64 ;;
    *) arch=unsupported ;;
  esac
  printf '%s-%s' "$os" "$arch"
}

install_jq() {
  local tag url
  tag="$(platform_tag)"
  case "$tag" in
    *unsupported*) return 1 ;;
  esac
  command -v curl >/dev/null 2>&1 || return 1
  url="https://github.com/jqlang/jq/releases/download/jq-1.7.1/jq-$tag"
  curl -fsSL "$url" -o "$EDCACHE/bin/jq.download" || return 1
  chmod +x "$EDCACHE/bin/jq.download"
  "$EDCACHE/bin/jq.download" --version >/dev/null 2>&1 || {
    rm -f "$EDCACHE/bin/jq.download"
    return 1
  }
  mv "$EDCACHE/bin/jq.download" "$EDCACHE/bin/jq"
}

install_bun() {
  command -v curl >/dev/null 2>&1 || return 1
  command -v unzip >/dev/null 2>&1 || return 1
  BUN_INSTALL="$EDCACHE/bun" bash -c 'curl -fsSL https://bun.sh/install | bash' >/dev/null 2>&1 \
    || return 1
  [ -x "$EDCACHE/bun/bin/bun" ]
}

label_for() {
  case "$1" in
    cli) echo "Claude Code" ;;
    cowork) echo "Cowork" ;;
    codex) echo "Codex" ;;
    opencode) echo "OpenCode" ;;
    commandcode) echo "Command Code" ;;
    amp) echo "Amp" ;;
    droid) echo "Droid" ;;
    codebuff) echo "Codebuff" ;;
    hermes) echo "Hermes" ;;
    pi) echo "pi-agent" ;;
    goose) echo "Goose" ;;
    kilo) echo "Kilo" ;;
    gemini) echo "Gemini" ;;
    copilot) echo "GitHub Copilot" ;;
    kimi) echo "Kimi" ;;
    qwen) echo "Qwen" ;;
    openclaw) echo "OpenClaw" ;;
    cursor) echo "Cursor Agent" ;;
    *) echo "$1" ;;
  esac
}

GITHUB='
def githubRepositoryID:
  tostring
  | ascii_downcase
  | sub("[?#].*$"; "")
  | sub("/+$"; "")
  | if test("^git@github\\.com:") then sub("^git@github\\.com:"; "")
    elif test("^ssh://(git@)?github\\.com/") then sub("^ssh://(git@)?github\\.com/"; "")
    elif test("^https?://([^/@]+@)?github\\.com/") then sub("^https?://([^/@]+@)?github\\.com/"; "")
    elif test("^git://github\\.com/") then sub("^git://github\\.com/"; "")
    elif test("^github\\.com[:/]") then sub("^github\\.com[:/]"; "")
    else "" end
  | sub("\\.git$"; "")
  | split("/")
  | if length == 2 and all(.[]; . != "") then "github.com/" + join("/") else "" end;
'

CWD_CACHE='
  ($want | split("\n") | map(select(. != ""))
    | map({(.): true}) | add // {}) as $W
  | ($fingerprints[0] // {}) as $F
  | ($F[.cwd] // {verified: false, fingerprint: ""}) as $current
  | select($W[.cwd]
      and ((.repositoryID // "") | startswith("github.com/"))
      and (if $current.verified then
          ((.repositoryFingerprint // "") != "")
          and .repositoryFingerprint == $current.fingerprint
        else true end))
'

NORM='
def dropSynthetic:
  map(select(.modelName != "<synthetic>"
    or (.inputTokens + .outputTokens + .cacheCreationTokens + .cacheReadTokens + .cost) > 0));
def normDay:
  if (.modelBreakdowns | type) == "array" then
    { period: .date, breakdowns: [ .modelBreakdowns[] | {
        modelName: (.modelName // "unknown"),
        inputTokens: (.inputTokens // 0),
        outputTokens: (.outputTokens // 0),
        cacheCreationTokens: (.cacheCreationTokens // 0),
        cacheReadTokens: (.cacheReadTokens // 0),
        cost: (.cost // .costUSD // 0)
      } ] }
  elif (.models | type) == "object" then
    (.costUSD // .totalCost // 0) as $cost
    | [ .models | to_entries[] ] as $models
    | [ $models[] | {
        modelName: .key,
        inputTokens: (.value.inputTokens // 0),
        outputTokens: (.value.outputTokens // 0),
        cacheCreationTokens: (.value.cacheCreationTokens // 0),
        cacheReadTokens: (.value.cacheReadTokens // 0),
        cost: (if ($models | length) == 1 then $cost else 0 end)
      } ] as $breakdowns
    | { period: .date,
        breakdowns: ($breakdowns
          + if ($models | length) != 1 and $cost != 0 then [{
              modelName: "unattributed-cost",
              inputTokens: 0,
              outputTokens: 0,
              cacheCreationTokens: 0,
              cacheReadTokens: 0,
              cost: $cost
            }] else [] end) }
  else
    . as $d
    | (($d.modelsUsed // []) | if length == 1 then .[0] else "unknown" end) as $model
    | { period: .date, breakdowns: [ {
        modelName: $model,
        inputTokens: ($d.inputTokens // 0),
        outputTokens: ($d.outputTokens // 0),
        cacheCreationTokens: ($d.cacheCreationTokens // 0),
        cacheReadTokens: ($d.cacheReadTokens // 0),
        cost: ($d.totalCost // $d.costUSD // 0)
      } ] }
  end;
'

ASSEMBLE='
  . as $srcs
  | [ $srcs[].source ] as $sources
  | ( reduce $srcs[] as $s ({};
        reduce $s.norm[] as $day (.;
          .[$day.period][$s.source] = $day.breakdowns)) ) as $byDate
  | ( [ $byDate[] | .[] | .[] ] ) as $all
  | {
      schemaVersion: 2,
      generatedAt: $now,
      sources: $sources,
      defaultSources: $sources,
      sourceMeta: ( reduce $srcs[] as $s ({}; .[$s.source] = { label: $s.label, tool: $s.label }) ),
      totals: {
        cost: ([ $all[].cost ] | add // 0),
        tokens: ([ $all[] | (.inputTokens + .outputTokens + .cacheCreationTokens + .cacheReadTokens) ] | add // 0),
        inputTokens: ([ $all[].inputTokens ] | add // 0),
        outputTokens: ([ $all[].outputTokens ] | add // 0),
        cacheCreationTokens: ([ $all[].cacheCreationTokens ] | add // 0),
        cacheReadTokens: ([ $all[].cacheReadTokens ] | add // 0)
      },
      daily: ( $byDate | to_entries | sort_by(.key) | map({ period: .key, bySource: .value }) ),
      sessions: [ $ss[0][] | .sessions[] ]
    }
'

HISTORY='
  def dedupe: reduce .[] as $value ([]; if index($value) then . else . + [$value] end);
  def localSources($values):
    [ $values[]? | select(startswith("machine:") | not) ];
  def keepSources($allowed):
    with_entries(select(.key as $key | $allowed | index($key)));
  def sourceTokens($sources):
    [ $sources[].tokens // 0 ] | add // 0;
  def sourceCost($sources):
    [ $sources[].cost // 0 ] | add // 0;
  def trimNode($value; $allowed):
    (($value.bySource // {}) | keepSources($allowed)) as $sources
    | ($value // {}) + {
        tokens: sourceTokens($sources),
        cost: sourceCost($sources),
        bySource: $sources
      };
  def mergeNode($old; $new):
    (($old.bySource // {}) + ($new.bySource // {})) as $sources
    | ($old + $new) + {
        tokens: sourceTokens($sources),
        cost: sourceCost($sources),
        bySource: $sources
      };
  def trimHour($value; $allowed):
    trimNode($value; $allowed)
    | .byPath = ((.byPath // {})
        | with_entries(.value = trimNode(.value; $allowed))
        | with_entries(select((.value.bySource | length) > 0)));
  def mergeHour($old; $new):
    ((($old.byPath // {}) + ($new.byPath // {})) | keys) as $paths
    | mergeNode($old; $new)
    | .byPath = (reduce $paths[] as $path ({};
        .[$path] = mergeNode(
          ($old.byPath[$path] // {});
          ($new.byPath[$path] // {})
        )));
  def trimProject($value; $allowed):
    trimNode($value; $allowed)
    | .chats = [ ($value.chats // [])[]
        | select(.source as $source | $allowed | index($source)) ]
    | .worktrees = [ ($value.worktrees // [])[]
        | .chats = [ (.chats // [])[]
            | select(.source as $source | $allowed | index($source)) ]
        | select((.chats | length) > 0)
        | .tokens = ([ .chats[].tokens // 0 ] | add // 0)
        | .cost = ([ .chats[].cost // 0 ] | add // 0) ];
  def trimDay($value; $allowed):
    {
      period: $value.period,
      bySource: (($value.bySource // {}) | keepSources($allowed)),
      hours: [ range(0; 24) as $hour
        | trimHour(($value.hours[$hour] // {}); $allowed) ],
      projects: [ ($value.projects // [])[]
        | trimProject(.; $allowed)
        | select((.bySource | length) > 0) ]
    };
  def mergeDay($old; $new):
    localSources(($old.bySource // {}) | keys) as $oldSources
    | (($new.bySource // {}) | keys) as $newSources
    | ($oldSources - $newSources) as $carriedSources
    | trimDay($old; $carriedSources) as $history
    | {
        period: $new.period,
        bySource: ($history.bySource + ($new.bySource // {})),
        hours: [ range(0; 24) as $hour
          | mergeHour(
              ($history.hours[$hour] // {});
              ($new.hours[$hour] // {})
            ) ],
        projects: ($history.projects + ($new.projects // []))
      };
  $previous[0] as $old
  | $fresh[0] as $new
  | localSources($old.sources // []) as $oldSources
  | localSources($old.defaultSources // []) as $oldDefaults
  | (($old.sourceMeta // {})
      | with_entries(select(.key | startswith("machine:") | not))) as $oldMeta
  | ([ ($old.daily // [])[].period, ($new.daily // [])[].period ] | unique | sort) as $periods
  | {
      schemaVersion: $new.schemaVersion,
      generatedAt: $new.generatedAt,
      sources: (($oldSources + ($new.sources // [])) | dedupe),
      defaultSources: (($oldDefaults + ($new.defaultSources // [])) | dedupe),
      sourceMeta: ($oldMeta + ($new.sourceMeta // {})),
      sessions: ([ ($old.sessions // [])[]
          | select(.source | startswith("machine:") | not) ]
        + ($new.sessions // []) | unique_by([.source, .id])),
      daily: [ $periods[] as $period
        | ([ ($old.daily // [])[] | select(.period == $period) ][0] // null) as $oldDay
        | ([ ($new.daily // [])[] | select(.period == $period) ][0] // null) as $newDay
        | if $oldDay == null then $newDay
          elif $newDay == null then
            trimDay($oldDay; localSources(($oldDay.bySource // {}) | keys))
          else mergeDay($oldDay; $newDay)
          end ]
    }
  | ([ .daily[].bySource[][] ]) as $rows
  | .totals = {
      cost: ([ $rows[].cost // 0 ] | add // 0),
      tokens: ([ $rows[] | ((.inputTokens // 0) + (.outputTokens // 0)
        + (.cacheCreationTokens // 0) + (.cacheReadTokens // 0)) ] | add // 0),
      inputTokens: ([ $rows[].inputTokens // 0 ] | add // 0),
      outputTokens: ([ $rows[].outputTokens // 0 ] | add // 0),
      cacheCreationTokens: ([ $rows[].cacheCreationTokens // 0 ] | add // 0),
      cacheReadTokens: ([ $rows[].cacheReadTokens // 0 ] | add // 0)
    }
'

HISTORY_INPUT='
  (type == "object")
  and (.schemaVersion == 8)
  and ((.sources | type) == "array")
  and ((.defaultSources | type) == "array")
  and ((.sourceMeta | type) == "object")
  and ((.sessions | type) == "array")
  and ((.daily | type) == "array")
  and all(.daily[];
    ((.period | type) == "string")
    and ((.bySource | type) == "object")
    and ((.hours | type) == "array")
    and ((.hours | length) == 24)
    and ((.projects | type) == "array")
    and all(.bySource[];
      (type == "array")
      and all(.[];
        all([
          .inputTokens // 0,
          .outputTokens // 0,
          .cacheCreationTokens // 0,
          .cacheReadTokens // 0,
          .cost // 0
        ][]; type == "number" and isfinite and . >= 0))))
'

FLEET='
  def dedupe: reduce .[] as $x ([]; if index($x) then . else . + [$x] end);
  def qualify:
    (.machine.slug // "machine") as $slug
    | (.machine.name // .machine.slug // "machine") as $name
    | (.machine.host // "") as $host
    | (.machine.id // null) as $mid
    | if ($mid | type) != "string" then error("machine.id must be a UUID string")
      elif ($mid | test("^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$") | not)
        then error("machine.id must be a UUID string")
      else . end
    | ($mid | ascii_downcase) as $stableID
    | (.sourceMeta // {}) as $meta
    | def machinePrefix:
        if $stableID == "" then error("machine.id is required for source identity")
        else "machine:" + $stableID + ":" end;
      def sid($s): machinePrefix + $s;
      def qpath($path): machinePrefix + $path;
      def detailTokens($map): ([ $map[].tokens // 0 ] | add // 0);
      def detailCost($map): ([ $map[].cost // 0 ] | add // 0);
      def qsourceMap:
        reduce to_entries[] as $e
          ({}; .[sid($e.key)] = $e.value);
      def qpathMap:
        reduce (to_entries[]) as $e ({};
          (($e.value.bySource // {}) | qsourceMap) as $sources
          | if ($sources | length) > 0 then
              .[qpath($e.key)] = {
                tokens: detailTokens($sources),
                cost: detailCost($sources),
                bySource: $sources
              }
            else . end);
      def rechat:
        .source = sid(.source // "")
        | if ((.path // "") != "") then .path = qpath(.path) else . end;
      {
        machine: {
          id: $mid, name: $name, slug: $slug,
          host: $host,
          collectedAt: (.machine.collectedAt // .generatedAt),
          sources: [ (.sources // [])[] | sid(.) ]
        },
        sources: [ (.sources // [])[] | sid(.) ],
        defaultSources: [ (.defaultSources // .sources // [])[] | sid(.) ],
        sourceMeta: ( reduce ((.sources // [])[]) as $s ({};
            .[sid($s)] = {
              label: (($meta[$s].label // $s) + " · " + $name),
              tool: ($meta[$s].tool // $s),
              machine: $name,
              machineID: $mid,
              machineHost: $host
            }) ),
        sessions: [ (.sessions // [])[] | { id: (.id // ""), source: sid(.source // "") } ],
        daily: [ (.daily // [])[] | {
            period: .period,
            bySource: ( reduce ((.bySource // {}) | to_entries[]) as $e ({};
              .[sid($e.key)] = $e.value) ),
            hours: [ (.hours // [])[]
              | ((.bySource // {}) | qsourceMap) as $sources
              | .tokens = detailTokens($sources)
              | .cost = detailCost($sources)
              | .bySource = $sources
              | .byPath = ((.byPath // {}) | qpathMap) ],
            projects: [ (.projects // [])[]
              | . as $project
              | (($project.bySource // {}) | qsourceMap) as $sources
              | select(($sources | length) > 0)
              | ($project.repositoryID // ("folder:" + ($project.path // ""))) as $rid
              | ($project.repositoryName // $project.projectName // $project.folderName // "unknown") as $rname
              | {
                  projectName: $rname,
                  repositoryID: (if ($rid | startswith("github.com/")) then $rid else qpath($rid) end),
                  repositoryName: $rname,
                  repositoryURL: ($project.repositoryURL // null),
                  folderName: ($project.folderName // $project.projectName // $rname),
                  path: qpath($project.path // ""),
                  machineName: $name,
                  machineID: $mid,
                  tokens: detailTokens($sources),
                  cost: detailCost($sources),
                  bySource: $sources,
                  chats: [ ($project.chats // [])[]
                    | select((.tokens // 0) > 0 or (.cost // 0) > 0)
                    | rechat ],
                  worktrees: [ ($project.worktrees // [])[]
                    | . as $worktree
                    | [ (.chats // [])[]
                        | select((.tokens // 0) > 0 or (.cost // 0) > 0)
                        | rechat ] as $chats
                    | select(($chats | length) > 0)
                    | $worktree
                    | .tokens = ([ $chats[].tokens // 0 ] | add // 0)
                    | .cost = ([ $chats[].cost // 0 ] | add // 0)
                    | .chats = $chats ]
                }
              ]
          } ]
      };
  .[0] as $base
  | [ .[1:][] | qualify ] as $fleet
  | {
      schemaVersion: 8,
      generatedAt: $base.generatedAt,
      sources: ((($base.sources // []) + [ $fleet[].sources[] ]) | dedupe),
      defaultSources: ((($base.defaultSources // []) + [ $fleet[].defaultSources[] ]) | dedupe),
      sourceMeta: ( reduce $fleet[] as $m (($base.sourceMeta // {}); . + $m.sourceMeta) ),
      machines: [ $fleet[].machine ],
      sessions: (($base.sessions // []) + [ $fleet[].sessions[] ]),
      daily: ( (($base.daily // []) + [ $fleet[].daily[] ]) | group_by(.period)
        | map(. as $g | {
            period: $g[0].period,
            bySource: ( reduce $g[] as $d ({}; . + ($d.bySource // {})) ),
            hours: [ range(0; 24) | . as $h | {
                tokens: ([ $g[] | (.hours // [])[$h].tokens // 0 ] | add // 0),
                cost: ([ $g[] | (.hours // [])[$h].cost // 0 ] | add // 0),
                bySource: (reduce $g[] as $d ({};
                  . + (($d.hours // [])[$h].bySource // {}))),
                byPath: (reduce $g[] as $d ({};
                  . + (($d.hours // [])[$h].byPath // {})))
              } ],
            projects: ( reduce $g[] as $d ([]; . + ($d.projects // [])) )
          })
        | sort_by(.period) )
    }
  | ( [ .daily[].bySource[][] ] ) as $all
  | .totals = {
      cost: ([ $all[].cost // 0 ] | add // 0),
      tokens: ([ $all[] | ((.inputTokens // 0) + (.outputTokens // 0)
        + (.cacheCreationTokens // 0) + (.cacheReadTokens // 0)) ] | add // 0),
      inputTokens: ([ $all[].inputTokens // 0 ] | add // 0),
      outputTokens: ([ $all[].outputTokens // 0 ] | add // 0),
      cacheCreationTokens: ([ $all[].cacheCreationTokens // 0 ] | add // 0),
      cacheReadTokens: ([ $all[].cacheReadTokens // 0 ] | add // 0)
    }
'

EMPTY='
  {
    schemaVersion: 8, generatedAt: $now, sources: [], defaultSources: [], sourceMeta: {},
    totals: { cost: 0, tokens: 0, inputTokens: 0, outputTokens: 0,
      cacheCreationTokens: 0, cacheReadTokens: 0 },
    daily: [], sessions: []
  }
'

VALIDATE='
  def tokenSum($rows; $field): [ $rows[] | (.[$field] // 0) ] | add // 0;
  def near($actual; $expected):
    (($actual - $expected) | if . < 0 then -. else . end)
    <= 0.000001;
  def nonnegativeNumber: type == "number" and isfinite and . >= 0;
  def detailSource:
    . as $source
    | (.tokens | nonnegativeNumber) and (.cost | nonnegativeNumber)
    and ((.byModel | type) == "object")
    and all(.byModel[];
      (.tokens | nonnegativeNumber) and (.cost | nonnegativeNumber))
    and ($source.tokens == ([ $source.byModel[].tokens ] | add // 0))
    and near($source.cost; ([ $source.byModel[].cost ] | add // 0));
  def detailSources:
    (type == "object") and all(.[]; detailSource);
  def detailNode:
    . as $node
    | (.tokens | nonnegativeNumber) and (.cost | nonnegativeNumber)
    and (.bySource | detailSources)
    and ($node.tokens == ([ $node.bySource[].tokens ] | add // 0))
    and near($node.cost; ([ $node.bySource[].cost ] | add // 0));
  [ .daily[].bySource[][] ] as $rows
  | ([ .daily[].period ] | length) as $dayCount
  | ([ .daily[].period ] | unique | length) as $uniqueDayCount
  | (.schemaVersion == 8)
    and (. as $root | all($root.defaultSources[]; . as $source | ($root.sources | index($source)) != null))
    and ($dayCount == $uniqueDayCount)
    and ([ .daily[].period ] == ([ .daily[].period ] | sort))
    and ((.sources | length) == (.sources | unique | length))
    and all(.daily[];
      . as $day
      | ($day.bySource | with_entries(.value = {
          tokens: ([.value[] | ((.inputTokens // 0) + (.outputTokens // 0)
            + (.cacheCreationTokens // 0) + (.cacheReadTokens // 0))] | add // 0),
          cost: ([.value[].cost // 0] | add // 0)
        })) as $authoritative
      | ([ $day.projects[]?.bySource | to_entries[] ]
          | group_by(.key)
          | map({key: .[0].key, value: {
              tokens: ([.[].value.tokens // 0] | add // 0),
              cost: ([.[].value.cost // 0] | add // 0)
            }}) | from_entries) as $detail
      | ((.hours | type) == "array") and ((.hours | length) == 24)
      and ((.projects | type) == "array")
      and all(.hours[];
        detailNode
        and ((.byPath | type) == "object")
        and all(.byPath[]; detailNode))
      and all(.projects[];
        ((.repositoryID | type) == "string")
        and ((.repositoryName | type) == "string")
        and ((.folderName | type) == "string")
        and ((.path | type) == "string")
        and detailNode
        and ((.chats | type) == "array")
        and ((.worktrees | type) == "array"))
      and all($detail | to_entries[];
        .value.tokens <= ($authoritative[.key].tokens // 0)
        and (.value.cost <= ($authoritative[.key].cost // 0)
          or near(.value.cost; ($authoritative[.key].cost // 0)))))
    and all($rows[];
      all([.inputTokens, .outputTokens, .cacheCreationTokens, .cacheReadTokens, .cost][];
        nonnegativeNumber))
    and ((.totals.inputTokens // -1) == tokenSum($rows; "inputTokens"))
    and ((.totals.outputTokens // -1) == tokenSum($rows; "outputTokens"))
    and ((.totals.cacheCreationTokens // -1) == tokenSum($rows; "cacheCreationTokens"))
    and ((.totals.cacheReadTokens // -1) == tokenSum($rows; "cacheReadTokens"))
    and near((.totals.cost // -1); ([ $rows[].cost ] | add // 0))
    and ((.totals.tokens // -1) ==
      (tokenSum($rows; "inputTokens") + tokenSum($rows; "outputTokens")
        + tokenSum($rows; "cacheCreationTokens") + tokenSum($rows; "cacheReadTokens")))
'

